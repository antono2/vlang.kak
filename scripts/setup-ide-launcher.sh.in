#!/bin/sh
# vlang.kak managed IDE launcher
XDG_CONFIG_HOME=@ISOLATED@
VLANG_KAK_CONFIG_HOME=@CONFIG_HOME@
PATH=@BIN@:@COMPILER_PATH@$PATH
VLANG_KAK_PREFIX=@PREFIX@
VLANG_KAK_REPO=@REPO@
export XDG_CONFIG_HOME PATH VLANG_KAK_CONFIG_HOME VLANG_KAK_PREFIX VLANG_KAK_REPO
if command -v v >/dev/null 2>&1; then
    exec "$VLANG_KAK_REPO/scripts/helper-cache.sh" launcher "$@"
fi
exec "$VLANG_KAK_REPO/scripts/launcher-posix" "$@"
