#!/bin/sh
# Keep checkpoints available in editor installations without V.
set -eu
umask 077
quote() { printf "'"; printf %s "$1" | sed "s/'/''/g"; printf "'"; }
fail() { printf 'fail %s\n' "$(quote "$1")"; exit 1; }
write_restart_state() {
  temporary=$(mktemp -- "$1.XXXXXXXX") || fail 'Could not write restart state'
  trap 'rm -f -- "$temporary"' EXIT
  printf '%s\n' "$2" > "$temporary" && mv -fT -- "$temporary" "$1" ||
    fail 'Could not write restart state'
}
client_source() {
  # A client ID is a SHA-256 digest encoded as 64 lowercase hex characters.
  case $1 in *[!0-9a-f]*) fail 'Invalid checkpoint client identity' ;; esac
  [ "${#1}" -eq 64 ] || fail 'Invalid checkpoint client identity'
  client_file=$directory/client-$1.kak
  [ -f "$client_file" ] || fail 'Checkpoint client instructions are missing'
}
case $1 in
  save-buffers|save-clients|check-buffers|close-clients)
    action=$1
    shift
    for name do
      quoted=$(quote "$name")
      case $action in
        save-buffers) printf 'v-session-save-buffer %s\n' "$quoted" ;;
        save-clients) printf 'v-session-save-client %s\n' "$quoted" ;;
        check-buffers) printf 'v-session-check-buffer %s\n' "$quoted" ;;
        close-clients)
          [ "$name" = "${kak_client:-}" ] || printf 'evaluate-commands -client %s %%{ quit! }\n' "$quoted" ;;
      esac
    done
    exit 0 ;;
  restart-files)
    state=${VLANG_KAK_RESTART_STATE:-}
    [ -n "$state" ] || fail 'Restart requires the managed kak-v launcher'
    shift
    commands=nop
    for name do
      [ -f "$name" ] || continue
      quoted=$(quote "$name")
      commands="$commands
$(printf 'try %%{ buffer %s } catch %%{ edit -- %s }' "$quoted" "$quoted")"
    done
    resume_file=${kak_buffile:-}
    resume_line=${kak_cursor_line:-}
    resume_column=${kak_cursor_column:-}
    if [ ! -f "$resume_file" ]; then
      resume_file=${kak_opt_v_update_resume_file:-}
      resume_line=${kak_opt_v_update_resume_line:-}
      resume_column=${kak_opt_v_update_resume_column:-}
    fi
    if [ -f "$resume_file" ]; then
      commands="$commands
$(printf 'buffer %s\nselect %s.%s,%s.%s' "$(quote "$resume_file")" \
  "$resume_line" "$resume_column" "$resume_line" "$resume_column")"
    fi
    write_restart_state "$state" "$commands"
    exit 0 ;;
  begin)
    [ "$#" -eq 2 ] && [ -n "$2" ] || fail 'Expected a checkpoint root'
    mkdir -p -- "$2" || fail 'Could not create checkpoint root'
    root=$(readlink -f -- "$2") || fail 'Could not resolve checkpoint root'
    directory=$(mktemp -d -- "$root/checkpoint.XXXXXXXX") || fail 'Could not create checkpoint directory'
    printf 'set-option global v_session_checkpoint %s\n' "$(quote "$directory")"
    exit 0 ;;
  restore|restart)
    mode=$1
    directory=${2:-}
    state=${3:-}
    expected=2
    if [ "$mode" = restart ]; then expected=3; fi
    if [ "$#" -ne "$expected" ] || [ -z "$directory" ] || { [ "$mode" = restart ] && [ -z "$state" ]; }; then
      fail 'Expected a checkpoint directory and restart state when restarting'
    fi
    [ -f "$directory/buffers.kak" ] || fail 'No session checkpoint found'
    identity=$(cat "$directory/main-client") || fail 'Checkpoint main client is missing'
    client_source "$identity"
    commands=$(printf 'source %s\nsource %s' "$(quote "$directory/buffers.kak")" "$(quote "$client_file")")
    if [ "$mode" = restore ]; then printf '%s\n' "$commands"; exit 0; fi
    backend=$(cat "$directory/backend") || fail 'Checkpoint pane host is missing'
    [ -f "$directory/clients" ] || fail 'Checkpoint client list is missing'
    found_main=false
    extra_views=false
    while IFS= read -r other || [ -n "$other" ]; do
      if [ "$other" = "$identity" ]; then found_main=true; continue; fi
      extra_views=true
      client_source "$other"
      commands="$commands
$(printf 'v-session-open-client %s %s' "$(quote "$client_file")" "$(quote "$backend")")"
    done < "$directory/clients"
    [ "$found_main" = true ] || fail 'Checkpoint main client is missing from its client list'
    if [ "$extra_views" = true ] && { [ -z "$backend" ] || [ "$backend" = none ]; }; then
      fail 'Restoring extra views requires a supported pane host; checkpoint saved'
    fi
    write_restart_state "$state" "$commands"
    exit 0 ;;
esac
directory=$kak_opt_v_session_checkpoint
case $1 in
  finish)
    [ "$#" -eq 2 ] || exit 2
    backend=$2
    case "$backend" in ''|*'
'*) exit 1 ;; esac
    directory=$(readlink -f -- "$directory")
    [ -f "$directory/buffers.kak" ] && [ -f "$directory/clients" ] || exit 1
    identity=$(printf %s "$kak_client" | sha256sum | cut -d ' ' -f 1)
    found_main=false
    while IFS= read -r other || [ -n "$other" ]; do
      client_source "$other"
      if [ "$other" = "$identity" ]; then found_main=true; fi
    done < "$directory/clients"
    [ "$found_main" = true ] || exit 1
    printf '%s\n' "$identity" > "$directory/main-client"
    printf '%s\n' "$backend" > "$directory/backend"
    rm -f -- "$directory/session-checkpoint"
    root=$(dirname -- "$directory")
    stage=$(mktemp -d -- "$root/.latest.XXXXXXXX")
    trap 'rm -f -- "$stage/latest"; rmdir -- "$stage"' EXIT
    ln -s -- "$directory" "$stage/latest"
    mv -fT -- "$stage/latest" "$root/latest"
    printf '%s\n' 'echo -debug "Session checkpoint saved; v-session-restore reopens it"'
    exit 0 ;;
  client)
    identity=$(printf %s "$kak_client" | sha256sum | cut -d ' ' -f 1)
    printf 'rename-client %s\nbuffer %s\nselect %s\n' "$(quote "$kak_client")" "$(quote "$kak_bufname")" "$kak_selections_desc" > "$directory/client-$identity.kak"
    printf '%s\n' "$identity" >> "$directory/clients"
    exit ;;
  main)
    identity=$(printf %s "$kak_client" | sha256sum | cut -d ' ' -f 1)
    printf '%s\n' "$identity" > "$directory/main-client"
    exit ;;
  buffer) ;;
  *) exit 2 ;;
esac
[ "$kak_bufname" != "*debug*" ] || exit 0
# Before Kakoune 2026.04, scratch buffers expose their name as buffile.
# File buffers always expose an absolute path.
case "$kak_buffile" in /*|'') ;; *) kak_buffile= ;; esac
identity=$(printf %s "$kak_bufname" | sha256sum | cut -d ' ' -f 1)
copy=$directory/buffer-$identity
if [ -n "$kak_buffile" ] && [ "$kak_modified" != true ] && [ -f "$kak_buffile" ]; then
  printf 'edit -existing -- %s\n' "$(quote "$kak_buffile")" >> "$directory/buffers.kak"
else
  if [ -n "$kak_buffile" ]; then
    printf 'edit -existing -- %s\n' "$(quote "$kak_buffile")" >> "$directory/buffers.kak"
  else
    printf 'try %%{ buffer %s } catch %%{ edit -scratch %s }\n' "$(quote "$kak_bufname")" "$(quote "$kak_bufname")" >> "$directory/buffers.kak"
  fi
  # Suppress user write hooks: this is a recovery copy, not a project save.
  printf 'evaluate-commands -no-hooks %%{ write -force -- %s }\n' "$(quote "$copy")"
  command="%|cat -- '$(printf %s "$copy" | sed "s/'/'\\\\''/g")'"
  command=$(printf %s "$command" | sed 's/</<lt>/g')'<ret>'
  printf 'set-option buffer readonly false\nexecute-keys %s\n' "$(quote "$command")" >> "$directory/buffers.kak"
fi
restored_type=$kak_opt_filetype
if [ -z "$kak_buffile" ]; then
  case "$restored_type:$kak_bufname" in
    v-tree:*|v-doc:*|v-debug-*|make:*|lsp-*|*:\*hover\*) restored_type=v-recovery ;;
  esac
fi
printf 'set-option buffer filetype %s\nset-option buffer readonly %s\n' "$(quote "$restored_type")" "$kak_opt_readonly" >> "$directory/buffers.kak"
