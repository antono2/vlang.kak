#!/bin/sh
# Keep project prompts, completion and search usable before V is installed.
set -eu
[ "$#" -ge 2 ] || exit 2
case "$2" in
  /*) file=$2 ;;
  '') file=$PWD/ ;;
  *) file=$PWD/$2 ;;
esac
root=${file%/*}
[ -n "$root" ] || root=/
current=$root
while :; do
  if [ -f "$current/v.mod" ] || [ -d "$current/.git" ] || [ -f "$current/.git" ]; then
    root=$current
    break
  fi
  parent=${current%/*}
  [ -n "$parent" ] || parent=/
  [ "$parent" != "$current" ] || break
  current=$parent
done
prefix=${root%/}/
case "$1" in
  prompt)
    [ "$#" -eq 2 ] || exit 2
    escaped=$(printf '%s.' "$prefix" | sed "s/'/''/g")
    printf "prompt -file-completion -init '%s' 'Project path: ' %%{ edit -existing -- %%val{text} }\n" "${escaped%.}" ;;
  candidates)
    [ "$#" -eq 2 ] || exit 2
    if command -v rg >/dev/null 2>&1; then
      (cd "$root" && rg --files --hidden --glob '!.git')
    elif [ "$(git -C "$root" rev-parse --is-inside-work-tree 2>/dev/null)" = true ]; then
      git -c core.quotePath=false -C "$root" ls-files --cached --others --exclude-standard
    else
      (cd "$root" && find . -name .git -prune -o -type f -print)
    fi | while IFS= read -r path; do
      printf '%s%s\n' "$prefix" "${path#./}"
    done ;;
  search)
    [ "$#" -eq 5 ] || exit 2
    kak_quote() {
      escaped=$(printf '%s.' "$1" | sed "s/'/''/g")
      printf "'%s'" "${escaped%.}"
    }
    case "$3" in
      preview)
        if [ -z "$4" ]; then
          printf "info -title 'Project search' 'Type a pattern; Enter opens all results'\n"
          exit
        fi
        matches=$(
          cd "$root"
          if command -v rg >/dev/null 2>&1; then
            rg -n --no-heading --color never -e "$4" .
          else
            grep -RHn --exclude-dir=.git -e "$4" .
          fi 2>/dev/null | head -n 12 | cut -c 1-140
        )
        printf "info -title 'Project search · Enter for all' %s\n" "$(kak_quote "${matches:-No matches yet}")" ;;
      results)
        [ -n "$4" ] || exit 0
        if [ "$5" = 'grep -RHn' ]; then
          if command -v rg >/dev/null 2>&1; then
            printf "set-option window grepcmd 'rg -n --no-heading'\n"
          else
            printf "set-option window grepcmd 'grep -RHn --exclude-dir=.git'\n"
          fi
        fi
        printf 'grep -e %s %s\n' "$(kak_quote "$4")" "$(kak_quote "$root")"
        if [ "$5" = 'grep -RHn' ]; then
          printf 'unset-option window grepcmd\n'
        fi ;;
      *) exit 2 ;;
    esac ;;
  *) exit 2 ;;
esac
