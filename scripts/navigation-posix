#!/bin/sh
# Preserve navigation if the cached helper cannot be built or loaded.
action=${1:-}
client=${2:-}
shift 2 || exit 2
quote() {
    escaped=$(printf '%s.' "$1" | sed "s/'/''/g")
    printf "'%s'" "${escaped%.}"
}
escape_map() { printf '%s' "$1" | sed 's/[=\\]/\\&/g'; }
case $action in
  alternate)
    [ "$#" -eq 0 ] || exit 2
    case $client in
      *_test.v) path=${client%_test.v}.v; missing='implementation file not found' ;;
      *.v) path=${client%.v}_test.v; missing='test file not found' ;;
      *) echo "fail 'alternative file not found'"; exit ;;
    esac
    if [ -f "$path" ]; then
      printf 'edit -- %s\n' "$(quote "$path")"
    else
      printf 'fail %s\n' "$(quote "$missing")"
    fi
    ;;
  remember-doc|remember-results)
    [ "$#" -eq 2 ] || exit 2
    key=$(escape_map "$client")=
    view=${action#remember-}
    origin=$(escape_map "$1.")
    selection=$(escape_map "$2.")
    printf 'set-option -add global v_%s_origins %s\n' "$view" "$(quote "$key${origin%.}")"
    printf 'set-option -add global v_%s_selections %s\n' "$view" "$(quote "$key${selection%.}")"
    ;;
  doc|results)
    key=$(escape_map "$client")=
    origin=
    selection=
    field=origin
    for entry do
      case "$entry" in
        '') field=selection ;;
        "$key"*)
          value=$(printf '%s.' "${entry#"$key"}" | sed 's/\\\([=\\]\)/\1/g')
          case "$field" in
            origin) origin=${value%.} ;;
            selection) selection=${value%.} ;;
          esac ;;
      esac
    done
    if [ -n "$origin" ]; then
      printf 'v-%s-install %s %s\n' "$action" "$(quote "$origin")" "$(quote "$selection")"
    fi ;;
esac
